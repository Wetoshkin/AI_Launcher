<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Launcher.Desktop.Controls.HelpHint"
             VerticalAlignment="Center">
  <Button x:Name="Badge" Width="19" Height="19" CornerRadius="10" Padding="0"
          Background="{DynamicResource AccentSoftBrush}"
          BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
          Cursor="Help" VerticalAlignment="Center" ToolTip.Tip="Нажмите для подсказки">
    <TextBlock Text="?" FontSize="12" FontWeight="Bold"
               Foreground="{DynamicResource AccentBrush}"
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Button.Flyout>
      <Flyout Placement="Bottom"/>
    </Button.Flyout>
  </Button>
</UserControl>
