<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels"
             xmlns:nav="using:Launcher.Desktop.Navigation"
             xmlns:l="using:Launcher.Desktop.Localization"
             x:Class="Launcher.Desktop.Views.ShellView"
             x:DataType="vm:ShellViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,4"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource InkSoftBrush}"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="264,*" Background="{DynamicResource PaperBrush}">
    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">

        <!-- Бренд -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="22,26,18,18">
          <Image Source="avares://Launcher.Desktop/Assets/ai-launcher-studio.png" Width="34" Height="34"/>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="AI Launcher Studio" FontSize="16.5" FontWeight="Bold"/>
            <TextBlock Text="{l:T app.subtitle}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}"/>
          </StackPanel>
        </StackPanel>

        <!-- Навигация -->
        <ListBox Grid.Row="1" Classes="nav"
                 ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="nav:NavigationItem">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding Icon}" FontSize="16" Width="22" TextAlignment="Center"/>
                <TextBlock Text="{Binding Title}" FontSize="14.5" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- Железо -->
        <Border Grid.Row="2" Margin="16" Padding="14,12" CornerRadius="12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel Spacing="3">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="🖥" FontSize="13"/>
              <TextBlock Text="{l:T hardware.title}" FontSize="11.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource InkSoftBrush}"/>
            </StackPanel>
            <TextBlock Text="{Binding HardwareSummary}" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
  </Grid>
</UserControl>
