<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels"
             x:Class="Launcher.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <Grid ColumnDefinitions="220,*" Background="#F6F2EB" Margin="18">
    <Border Grid.Column="0"
            Background="#FFFAF2"
            BorderBrush="#EADCC9"
            BorderThickness="1"
            CornerRadius="22"
            Padding="14">
      <StackPanel Spacing="12">
        <TextBlock Text="Пресеты" FontWeight="Bold" FontSize="16"/>
        <TextBlock Text="быстрый запуск" FontSize="11" Foreground="#7B6C5B"/>
        <ItemsControl ItemsSource="{Binding Presets}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="White"
                      BorderBrush="#EADCC9"
                      BorderThickness="1"
                      CornerRadius="14"
                      Padding="10"
                      Margin="0,0,0,8">
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Новый пресет"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Column="1" Margin="18,0,0,0" Spacing="16">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="Bold" Foreground="#20242C"/>
          <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#6F7785"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Border Background="White" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="12" Padding="10,7">
            <TextBlock Text="{Binding GpuStatus}"/>
          </Border>
          <Button Content="{Binding PortStatus}"
                  Command="{Binding CheckPortCommand}"
                  Background="#FFF0DB"
                  BorderBrush="#FFBD74"
                  Foreground="#A95508"/>
          <Border Background="#EEF8FB" BorderBrush="#C8E6EE" BorderThickness="1" CornerRadius="12" Padding="10,7">
            <TextBlock Text="{Binding RuntimeStatus}" Foreground="#20677A"/>
          </Border>
        </StackPanel>
      </DockPanel>

      <Grid ColumnDefinitions="*,150,Auto,Auto" ColumnSpacing="8">
        <ItemsControl Grid.Column="0" ItemsSource="{Binding WizardSteps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WizardStepRowViewModel">
              <Border Background="#FFFAF2"
                      BorderBrush="#EADCC9"
                      BorderThickness="1"
                      CornerRadius="10"
                      Padding="8,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Number}" Foreground="#C15F00" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Label}" Foreground="#574A3C"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Column="1"
                   Text="{Binding CurrentWizardStepText}"
                   VerticalAlignment="Center"
                   Foreground="#C15F00"
                   FontWeight="Bold"
                   TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="2" Content="Назад" Command="{Binding PreviousStepCommand}"/>
        <Button Grid.Column="3" Content="Далее" Command="{Binding NextStepCommand}"/>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Button Grid.Column="0"
                MinHeight="220"
                Background="White"
                BorderBrush="#FF9B35"
                BorderThickness="2"
                Command="{Binding SelectAgentModeCommand}"
                HorizontalContentAlignment="Stretch">
          <StackPanel Margin="18">
            <TextBlock Text="ПРОЕКТ" Foreground="#C15F00" FontWeight="Bold"/>
            <TextBlock Text="Запустить агента" FontSize="30" FontWeight="Bold" Margin="0,42,0,8"/>
            <TextBlock Text="проект · агент · модель · runtime · старт" Foreground="#697386"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1"
                MinHeight="220"
                Background="White"
                BorderBrush="#70B8C7"
                BorderThickness="2"
                Command="{Binding SelectEndpointModeCommand}"
                HorizontalContentAlignment="Stretch">
          <StackPanel Margin="18">
            <TextBlock Text="СЕРВЕР" Foreground="#247187" FontWeight="Bold"/>
            <TextBlock Text="Поднять endpoint" FontSize="30" FontWeight="Bold" Margin="0,42,0,8"/>
            <TextBlock Text="модель · контекст · KV · MTP · сервер" Foreground="#697386"/>
          </StackPanel>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Button Grid.Column="0" HorizontalContentAlignment="Stretch" Padding="14" Command="{Binding ChooseModelsFolderCommand}">
          <Grid ColumnDefinitions="34,*">
            <PathIcon Grid.Column="0"
                      Width="22"
                      Height="22"
                      Foreground="#C15F00"
                      Data="M3,6 L8,6 L10,8 L21,8 L21,18 L3,18 Z M3,8 L21,8"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Папка моделей" FontWeight="Bold"/>
              <TextBlock Text="{Binding ModelsFolderPath}" Foreground="#7B6C5B" FontSize="12"/>
              <TextBlock Text="{Binding ModelCountText}" Foreground="#A95508" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="1" HorizontalContentAlignment="Stretch" Padding="14" Command="{Binding ChooseProjectsFolderCommand}">
          <Grid ColumnDefinitions="34,*">
            <PathIcon Grid.Column="0"
                      Width="22"
                      Height="22"
                      Foreground="#247187"
                      Data="M3,6 L8,6 L10,8 L21,8 L21,18 L3,18 Z M3,8 L21,8"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Папка проектов" FontWeight="Bold"/>
              <TextBlock Text="{Binding ProjectsFolderPath}" Foreground="#A95508" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="Агент" FontWeight="Bold"/>
          <ComboBox ItemsSource="{Binding AgentOptions}"
                    SelectedItem="{Binding SelectedAgent}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="Runtime" FontWeight="Bold"/>
          <ComboBox ItemsSource="{Binding RuntimeOptions}"
                    SelectedItem="{Binding SelectedRuntime}"/>
        </StackPanel>
      </Grid>

      <Border Background="#FFF8EC" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="12" Padding="12">
        <TextBlock Text="{Binding StatusMessage}" Foreground="#765A36"/>
      </Border>

      <Border Background="White" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="14" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="Проверка запуска" FontWeight="Bold" FontSize="15"/>
          <ComboBox ItemsSource="{Binding DecodingPresets}"
                    SelectedItem="{Binding SelectedDecodingPreset}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DecodingPresetRowViewModel">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Risk}" FontSize="11" Foreground="#A95508"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding SelectedDecodingPreset.Description}"
                     Foreground="#765A36"
                     TextWrapping="Wrap"/>
          <Button Content="Собрать команду"
                  Command="{Binding BuildLaunchCommandCommand}"
                  HorizontalAlignment="Left"/>
          <Button Content="Запустить"
                  Command="{Binding StartLaunchCommand}"
                  Background="#FF9B35"
                  Foreground="White"
                  HorizontalAlignment="Left"/>
          <Border Background="#1F2328" CornerRadius="8" Padding="10">
            <TextBlock Text="{Binding LaunchCommandPreview}"
                       Foreground="#F8E8C8"
                       FontFamily="Consolas"
                       TextWrapping="Wrap"/>
          </Border>
          <ItemsControl ItemsSource="{Binding LaunchEnvironmentLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#765A36" FontFamily="Consolas" FontSize="12"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding LaunchReviewLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#5A4D3E" Margin="0,0,0,4"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <UniformGrid Columns="4">
        <Button Content="Модели"/>
        <Button Content="Рантаймы"/>
        <Button Content="Агенты"/>
        <Button Content="Журнал"/>
      </UniformGrid>

      <Border Background="White" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="14" Padding="14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Grid.Column="0"
                     PlaceholderText="Поиск локальных GGUF: qwen, q4, coder..."
                     Text="{Binding ModelSearchText}"/>
            <Button Grid.Column="1"
                    Content="Обновить"
                    Command="{Binding RefreshModelsCommand}"/>
          </Grid>
          <ListBox ItemsSource="{Binding LocalModels}"
                   SelectedItem="{Binding SelectedLocalModel}"
                   MaxHeight="260">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModelRowViewModel">
                <Grid ColumnDefinitions="*,90,80,80" ColumnSpacing="10" Margin="0,4">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Path}" Foreground="#8A7660" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Family}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Quant}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding Size}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Background="White" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="14" Padding="14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="10">
            <TextBox Grid.Column="0"
                     PlaceholderText="Поиск Hugging Face GGUF"
                     Text="{Binding HfSearchText}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding HfSortOptions}"
                      SelectedItem="{Binding HfSort}"/>
            <Button Grid.Column="2"
                    Content="Найти"
                    Command="{Binding SearchHuggingFaceCommand}"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding RemoteModels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RemoteModelRowViewModel">
                <Border Background="#FFF8EC"
                        BorderBrush="#EADCC9"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,8">
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,95,70,90" ColumnSpacing="10" RowSpacing="8">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Id}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Tags}" Foreground="#8A7660" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Downloads}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding Likes}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding Compatibility}" HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding DownloadOptionsText}" Foreground="#A95508" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <ItemsControl Grid.Row="1"
                                  Grid.ColumnSpan="4"
                                  ItemsSource="{Binding DownloadOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RemoteGgufDownloadOptionRowViewModel">
                          <Border Background="White"
                                  BorderBrush="#F1D2A8"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="8,5"
                                  Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Quant}" Foreground="#C15F00" FontWeight="Bold"/>
                              <TextBlock Text="{Binding Label}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding FileCountText}" Foreground="#7B6C5B"/>
                              <TextBlock Text="{Binding ModeText}" Foreground="#247187"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
