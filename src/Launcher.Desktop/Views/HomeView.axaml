<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels"
             x:Class="Launcher.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#2C241B"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Background" Value="#FFF9F0"/>
      <Setter Property="BorderBrush" Value="#E6CBA6"/>
      <Setter Property="Foreground" Value="#33291F"/>
    </Style>
    <Style Selector="Button.mode-card">
      <Setter Property="MinHeight" Value="156"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#E86F16"/>
      <Setter Property="BorderBrush" Value="#E86F16"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#FFF4E5"/>
      <Setter Property="BorderBrush" Value="#F0C99B"/>
      <Setter Property="Foreground" Value="#8C4508"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFF0D9"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFE4BD"/>
      <Setter Property="Foreground" Value="#2C241B"/>
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#FFD8A3"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="TabControl">
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="292,*" Background="#F7EFE3">
    <Border Grid.Column="0"
            Background="#FFF7EA"
            BorderBrush="#E7C89D"
            BorderThickness="0,0,1,0"
            Padding="20,22">
      <StackPanel Spacing="14">
        <StackPanel Spacing="2">
          <TextBlock Text="Пресеты" FontWeight="Bold" FontSize="18"/>
          <TextBlock Text="быстрый запуск сохранённых профилей" FontSize="12" Foreground="#806B54"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Presets}"
                 SelectedItem="{Binding SelectedPreset}"
                 MaxHeight="500">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PresetRowViewModel">
              <Border Background="White"
                      BorderBrush="#E7C89D"
                      BorderThickness="1"
                      CornerRadius="12"
                      MinHeight="108"
                      Padding="14"
                      Margin="0,0,0,2">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#A95508" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding ProjectPath}" FontSize="11" Foreground="#7B6C5B" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding ModelPath}" FontSize="11" Foreground="#7B6C5B" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Применить пресет"
                Command="{Binding ApplySelectedPresetCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Classes="primary"/>
        <Button Content="Сохранить текущий"
                Command="{Binding SaveCurrentPresetCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Classes="ghost"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,20,22,26" Spacing="14">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="Bold" Foreground="#201710"/>
          <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#76614C"/>
        </StackPanel>
        <WrapPanel Grid.Row="1">
          <Border Background="#FFF9F0" BorderBrush="#E6CBA6" BorderThickness="1" CornerRadius="12" Padding="12,8" MinWidth="132" Margin="0,0,8,8">
            <TextBlock Text="{Binding GpuStatus}" Foreground="#4B3B2A" TextTrimming="CharacterEllipsis"/>
          </Border>
          <Button Content="{Binding PortStatus}"
                  Command="{Binding CheckPortCommand}"
                  Classes="ghost"
                  Margin="0,0,8,8"/>
          <Border Background="#ECF9F8" BorderBrush="#A8DAD6" BorderThickness="1" CornerRadius="12" Padding="12,8" MinWidth="190" Margin="0,0,8,8">
            <TextBlock Text="{Binding RuntimeStatus}" Foreground="#20677A" TextTrimming="CharacterEllipsis"/>
          </Border>
        </WrapPanel>
      </Grid>

      <Grid ColumnDefinitions="*,170,Auto,Auto" ColumnSpacing="10">
        <ItemsControl Grid.Column="0" ItemsSource="{Binding WizardSteps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WizardStepRowViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,8,8">
              <Border Background="#FFF9F0"
                      BorderBrush="#E6CBA6"
                      BorderThickness="1"
                      CornerRadius="11"
                      Padding="10,7">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding Number}" Foreground="#C15F00" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Label}" Foreground="#574A3C"/>
                </StackPanel>
              </Border>
              <TextBlock Text="›" FontSize="18" Foreground="#C89A67" VerticalAlignment="Center"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Column="1"
                   Text="{Binding CurrentWizardStepText}"
                   VerticalAlignment="Center"
                   Foreground="#C15F00"
                   FontWeight="Bold"
                   TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="2" Content="Назад" Command="{Binding PreviousStepCommand}" Classes="ghost"/>
        <Button Grid.Column="3" Content="Далее" Command="{Binding NextStepCommand}" Classes="primary"/>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Button Grid.Column="0"
                Background="#FFF9F0"
                BorderBrush="#E86F16"
                BorderThickness="2"
                Command="{Binding SelectAgentModeCommand}"
                Classes="mode-card">
          <Grid Margin="16" ColumnDefinitions="72,*" ColumnSpacing="14">
            <Border Grid.Column="0"
                    Background="#FFE7C6"
                    BorderBrush="#F1B15B"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="72"
                    Height="72"
                    VerticalAlignment="Center">
              <TextBlock Text="01"
                         Foreground="#C15F00"
                         FontSize="24"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="#E86F16" CornerRadius="8" Padding="9,4">
                  <TextBlock Text="РЕЖИМ" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <TextBlock Text="проект и агент" Foreground="#8C4508" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="Запустить агента" FontSize="24" FontWeight="Bold" Foreground="#201710"/>
                <TextBlock Text="Открывает выбранный агент в папке проекта." Foreground="#6F5A45" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Grid.Row="2" Background="#FFF0D9" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                <TextBlock Text="Выбрать режим агента" Foreground="#C15F00" FontWeight="Bold"/>
              </Border>
            </Grid>
          </Grid>
        </Button>
        <Button Grid.Column="1"
                Background="#F7FFFB"
                BorderBrush="#49A58E"
                BorderThickness="2"
                Command="{Binding SelectEndpointModeCommand}"
                Classes="mode-card">
          <Grid Margin="16" ColumnDefinitions="72,*" ColumnSpacing="14">
            <Border Grid.Column="0"
                    Background="#DDF5EC"
                    BorderBrush="#82C9B7"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="72"
                    Height="72"
                    VerticalAlignment="Center">
              <TextBlock Text="02"
                         Foreground="#247187"
                         FontSize="24"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Background="#247187" CornerRadius="8" Padding="9,4">
                  <TextBlock Text="РЕЖИМ" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <TextBlock Text="сервер без агента" Foreground="#20677A" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="6">
                <TextBlock Text="Поднять сервер" FontSize="24" FontWeight="Bold" Foreground="#201710"/>
                <TextBlock Text="Запускает llama-server для внешнего клиента." Foreground="#526B6E" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Grid.Row="2" Background="#E5F8F0" CornerRadius="8" Padding="10,6" HorizontalAlignment="Left">
                <TextBlock Text="Выбрать серверный режим" Foreground="#247187" FontWeight="Bold"/>
              </Border>
            </Grid>
          </Grid>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Button Grid.Column="0" HorizontalContentAlignment="Stretch" Padding="16" Command="{Binding ChooseModelsFolderCommand}" Background="#FFF9F0" BorderBrush="#E6CBA6">
          <Grid ColumnDefinitions="34,*">
            <PathIcon Grid.Column="0"
                      Width="22"
                      Height="22"
                      Foreground="#C15F00"
                      Data="M3,6 L8,6 L10,8 L21,8 L21,18 L3,18 Z M3,8 L21,8"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Папка моделей" FontWeight="Bold" Foreground="#2C241B"/>
              <TextBlock Text="{Binding ModelsFolderPath}" Foreground="#7B6C5B" FontSize="12"/>
              <TextBlock Text="{Binding ModelCountText}" Foreground="#A95508" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="1" HorizontalContentAlignment="Stretch" Padding="16" Command="{Binding ChooseProjectsFolderCommand}" Background="#FFF9F0" BorderBrush="#E6CBA6">
          <Grid ColumnDefinitions="34,*">
            <PathIcon Grid.Column="0"
                      Width="22"
                      Height="22"
                      Foreground="#247187"
                      Data="M3,6 L8,6 L10,8 L21,8 L21,18 L3,18 Z M3,8 L21,8"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Папка проектов" FontWeight="Bold" Foreground="#2C241B"/>
              <TextBlock Text="{Binding ProjectsFolderPath}" Foreground="#A95508" FontSize="12"/>
            </StackPanel>
          </Grid>
        </Button>
      </Grid>

      <Grid ColumnDefinitions="*,*,140,160" ColumnSpacing="12">
        <StackPanel Grid.Column="0" Spacing="6">
          <TextBlock Text="Агент" FontWeight="Bold" Foreground="#6F5A45"/>
          <ComboBox ItemsSource="{Binding AgentOptions}"
                    SelectedItem="{Binding SelectedAgent}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Text="Runtime" FontWeight="Bold" Foreground="#6F5A45"/>
          <ComboBox ItemsSource="{Binding RuntimeOptions}"
                    SelectedItem="{Binding SelectedRuntime}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="6">
          <TextBlock Text="Порт" FontWeight="Bold" Foreground="#6F5A45"/>
          <NumericUpDown Minimum="1"
                         Maximum="65535"
                         Increment="1"
                         Value="{Binding Port}"/>
          <Button Content="Освободить"
                  Command="{Binding ReleasePortCommand}"
                  Classes="ghost"
                  ToolTip.Tip="Останавливает только безопасно распознанный llama-server на выбранном порту"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Spacing="6">
          <TextBlock Text="Контекст" FontWeight="Bold" Foreground="#6F5A45"/>
          <NumericUpDown Minimum="1024"
                         Maximum="1048576"
                         Increment="1024"
                         Value="{Binding ContextTokens}"/>
        </StackPanel>
      </Grid>

      <Border Background="#FFF8EC" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="8" Padding="0">
        <Grid ColumnDefinitions="5,*">
          <Border Grid.Column="0" Background="#E86F16" CornerRadius="8,0,0,8"/>
          <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#765A36" Padding="12,10"/>
        </Grid>
      </Border>

      <Border Background="White" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="Проверка запуска" FontWeight="Bold" FontSize="16"/>
              <TextBlock Text="{Binding ActiveProcessStatus}"
                         Foreground="#20677A"
                         FontWeight="Bold"
                         FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="Собрать команду"
                      Command="{Binding BuildLaunchCommandCommand}"/>
              <Button Content="Запустить"
                      Command="{Binding StartLaunchCommand}"
                      Classes="primary"/>
              <Button Content="Остановить"
                      Command="{Binding StopLaunchCommand}"
                      Classes="ghost"/>
              <Button Content="Очистить лог"
                      Command="{Binding ClearProcessLogCommand}"/>
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,130,130,150" ColumnSpacing="10">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding DecodingPresets}"
                      SelectedItem="{Binding SelectedDecodingPreset}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DecodingPresetRowViewModel">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Risk}" FontSize="11" Foreground="#A95508"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Grid.Column="1" Spacing="4"
                        ToolTip.Tip="-ctk / --cache-type-k: тип KV-cache для ключей. q8_0 обычно безопасный баланс, turbo* экономит VRAM только в совместимых runtime.">
              <TextBlock Text="KV ключи" FontWeight="Bold" FontSize="12"/>
              <ComboBox ItemsSource="{Binding KvCacheOptions}"
                        SelectedItem="{Binding SelectedKvCacheK}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4"
                        ToolTip.Tip="-ctv / --cache-type-v: тип KV-cache для значений. TurboQuant чаще всего даёт выигрыш именно на V-cache, но требует совместимый llama-server.">
              <TextBlock Text="KV значения" FontWeight="Bold" FontSize="12"/>
              <ComboBox ItemsSource="{Binding KvCacheOptions}"
                        SelectedItem="{Binding SelectedKvCacheV}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="4"
                        ToolTip.Tip="--spec-draft-n-max: сколько draft-токенов MTP предлагает за шаг. Меньше стабильнее, больше агрессивнее.">
              <TextBlock Text="MTP draft" FontWeight="Bold" FontSize="12"/>
              <NumericUpDown Minimum="1"
                             Maximum="16"
                             Increment="1"
                             Value="{Binding MtpDraftTokens}"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding SelectedDecodingPreset.Description}"
                     Foreground="#765A36"
                     TextWrapping="Wrap"/>
          <TextBlock Text="Команда" FontWeight="Bold" FontSize="12" Foreground="#6F5A45"/>
          <Border Background="#2F2923" CornerRadius="8" Padding="10">
            <TextBlock Text="{Binding LaunchCommandPreview}"
                       Foreground="#F8E8C8"
                       FontFamily="Consolas"
                       TextWrapping="Wrap"/>
          </Border>
          <TextBlock Text="Лог процесса" FontWeight="Bold" FontSize="12" Foreground="#6F5A45"/>
          <Border Background="#171A1F" CornerRadius="8" Padding="10" MinHeight="96">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
              <ItemsControl ItemsSource="{Binding ProcessLogLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}"
                               Foreground="#D9E8D6"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <ItemsControl ItemsSource="{Binding LaunchEnvironmentLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#765A36" FontFamily="Consolas" FontSize="12"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl ItemsSource="{Binding LaunchReviewLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#5A4D3E" Margin="0,0,0,4"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TabControl>
        <TabItem Header="Runtime">
      <Border Background="White" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="14" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="Runtime llama.cpp" FontWeight="Bold" FontSize="15"/>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="Zip-архив runtime" FontWeight="Bold" FontSize="12"/>
              <Grid ColumnDefinitions="*,42" ColumnSpacing="6">
                <TextBox Grid.Column="0"
                         Text="{Binding RuntimeArchivePath}"
                         PlaceholderText="D:\Downloads\llama-runtime.zip"/>
                <Button Grid.Column="1"
                        Command="{Binding PickRuntimeArchiveCommand}"
                        ToolTip.Tip="Выбрать zip-архив runtime">
                  <PathIcon Width="18"
                            Height="18"
                            Foreground="#C15F00"
                            Data="M3,6 L8,6 L10,8 L21,8 L21,18 L3,18 Z M3,8 L21,8"/>
                </Button>
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Папка установки" FontWeight="Bold" FontSize="12"/>
              <Grid ColumnDefinitions="*,42" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding RuntimeRootPath}"/>
                <Button Grid.Column="1"
                        Command="{Binding ChooseRuntimeRootFolderCommand}"
                        ToolTip.Tip="Выбрать папку установки runtime">
                  <PathIcon Width="18"
                            Height="18"
                            Foreground="#247187"
                            Data="M3,6 L8,6 L10,8 L21,8 L21,18 L3,18 Z M3,8 L21,8"/>
                </Button>
              </Grid>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
              <TextBlock Text="Кэш загрузок" FontWeight="Bold" FontSize="12"/>
              <Grid ColumnDefinitions="*,42" ColumnSpacing="6">
                <TextBox Grid.Column="0" Text="{Binding RuntimeCacheRootPath}"/>
                <Button Grid.Column="1"
                        Command="{Binding ChooseRuntimeCacheFolderCommand}"
                        ToolTip.Tip="Выбрать папку кэша runtime">
                  <PathIcon Width="18"
                            Height="18"
                            Foreground="#C15F00"
                            Data="M3,6 L8,6 L10,8 L21,8 L21,18 L3,18 Z M3,8 L21,8"/>
                </Button>
              </Grid>
            </StackPanel>
          </Grid>
          <WrapPanel>
            <ComboBox ItemsSource="{Binding RuntimeReleaseProfileOptions}"
                      SelectedItem="{Binding SelectedRuntimeReleaseProfileOption}"
                      MinWidth="150"
                      Margin="0,0,8,8">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RuntimeReleaseProfileOptionViewModel">
                  <TextBlock Text="{Binding Label}"
                             ToolTip.Tip="{Binding Tooltip}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding RuntimeReleaseSourceOptions}"
                      SelectedItem="{Binding SelectedRuntimeReleaseSourceOption}"
                      MinWidth="170"
                      Margin="0,0,8,8">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RuntimeReleaseSourceOptionViewModel">
                  <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Найти runtime"
                    Command="{Binding SearchRuntimeReleasesCommand}"
                    Margin="0,0,8,8"/>
            <Button Content="Проверить обновление"
                    Command="{Binding CheckRuntimeUpdateCommand}"
                    Margin="0,0,8,8"/>
            <Button Content="Скачать выбранный"
                    Command="{Binding DownloadSelectedRuntimeReleaseCommand}"
                    Margin="0,0,8,8"/>
            <Button Content="Скачать и установить"
                    Command="{Binding DownloadAndInstallSelectedRuntimeReleaseCommand}"
                    Margin="0,0,8,8"/>
            <Button Content="Отменить скачивание"
                    Command="{Binding CancelRuntimeDownloadCommand}"
                    Margin="0,0,8,8"/>
            <Button Content="Установить runtime"
                    Command="{Binding InstallRuntimePackageCommand}"
                    Classes="primary"
                    Margin="0,0,8,8"/>
            <Button Content="Проверить runtime"
                    Command="{Binding CheckPortCommand}"
                    Margin="0,0,8,8"/>
          </WrapPanel>
          <TextBlock Text="{Binding RuntimeReleaseProfileHint}"
                     Foreground="#765A36"
                     FontSize="12"
                     TextWrapping="Wrap"/>
          <ProgressBar Minimum="0"
                       Maximum="100"
                       Value="{Binding RuntimeDownloadProgressPercent}"
                       Height="8"/>
          <TextBlock Text="{Binding RuntimeDownloadProgressText}"
                     Foreground="#765A36"
                     FontSize="12"/>
          <TextBlock Text="{Binding RuntimeUpdateStatus}"
                     Foreground="#20677A"
                     FontSize="12"/>
          <TextBlock Text="{Binding RuntimeVersionSourceText}"
                     Foreground="#765A36"
                     FontSize="12"
                     TextTrimming="CharacterEllipsis"/>
          <ListBox ItemsSource="{Binding RuntimeReleasePackages}"
                   SelectedItem="{Binding SelectedRuntimeReleasePackage}"
                   MaxHeight="160">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RuntimeReleasePackageRowViewModel">
                <Grid ColumnDefinitions="*,150,130" ColumnSpacing="8" Margin="0,4">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Url}" Foreground="#8A7660" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <Border Grid.Column="1"
                          Background="#FFF0D9"
                          BorderBrush="#F1D2A8"
                          BorderThickness="1"
                          CornerRadius="8"
                          Padding="8,4"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding SourceLabel}"
                               Foreground="#8C4508"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                  </Border>
                  <TextBlock Grid.Column="2"
                             Text="{Binding Summary}"
                             Foreground="#A95508"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
        </TabItem>

        <TabItem Header="Агенты">
      <Border Background="White" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="14" Padding="14">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Агентные CLI" FontWeight="Bold" FontSize="15"/>
            <Button Grid.Column="1"
                    Content="Проверить"
                    Command="{Binding CheckAgentsCommand}"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding AgentCliStatuses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:AgentCliStatusRowViewModel">
                <Grid ColumnDefinitions="90,90,120,*" ColumnSpacing="8" Margin="0,3">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold"/>
                  <TextBlock Grid.Column="1" Text="{Binding Executable}" Foreground="#765A36"/>
                  <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#A95508"/>
                  <TextBlock Grid.Column="3" Text="{Binding Path}" Foreground="#7B6C5B" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
        </TabItem>

        <TabItem Header="Модели">
      <StackPanel Spacing="16">
      <Border Background="White" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="14" Padding="14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Grid.Column="0"
                     PlaceholderText="Поиск локальных GGUF: qwen, q4, coder..."
                     Text="{Binding ModelSearchText}"/>
            <Button Grid.Column="1"
                    Content="Обновить"
                    Command="{Binding RefreshModelsCommand}"/>
          </Grid>
          <ListBox ItemsSource="{Binding LocalModels}"
                   SelectedItem="{Binding SelectedLocalModel}"
                   MaxHeight="260">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ModelRowViewModel">
                <Grid ColumnDefinitions="*,90,80,80" ColumnSpacing="10" Margin="0,4">
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Path}" Foreground="#8A7660" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Family}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Quant}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding Size}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border Background="White" BorderBrush="#EADCC9" BorderThickness="1" CornerRadius="14" Padding="14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,150,120,130,130,Auto" ColumnSpacing="10">
            <TextBox Grid.Column="0"
                     PlaceholderText="Поиск Hugging Face GGUF"
                     Text="{Binding HfSearchText}"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding HfSortOptions}"
                      SelectedItem="{Binding HfSort}"/>
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding HfFamilyFilterOptions}"
                      SelectedItem="{Binding HfFamilyFilter}"
                      ToolTip.Tip="Фильтр семейства по repo id, tags и именам GGUF-файлов."/>
            <ComboBox Grid.Column="3"
                      ItemsSource="{Binding HfQuantFilterOptions}"
                      SelectedItem="{Binding HfQuantFilter}"
                      ToolTip.Tip="Фильтр по имени GGUF-файла в репозитории: Q4_K_M, Q5_K_M, Q6_K, Q8_0."/>
            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding HfSizeFilterOptions}"
                      SelectedItem="{Binding HfSizeFilter}"
                      ToolTip.Tip="Фильтр по суммарному размеру выбранного GGUF-варианта; неизвестный размер скрыт в диапазонах."/>
            <Button Grid.Column="5"
                    Content="Найти"
                    Command="{Binding SearchHuggingFaceCommand}"/>
          </Grid>
          <ListBox ItemsSource="{Binding RemoteModels}"
                   SelectedItem="{Binding SelectedRemoteModel}"
                   MaxHeight="300">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RemoteModelRowViewModel">
                <Border Background="#FFF8EC"
                        BorderBrush="#EADCC9"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,8">
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,95,70,90" ColumnSpacing="10" RowSpacing="8">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Id}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Tags}" Foreground="#8A7660" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Downloads}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="{Binding Likes}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                      <TextBlock Text="{Binding Compatibility}" HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding DownloadOptionsText}" Foreground="#A95508" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <ItemsControl Grid.Row="1"
                                  Grid.ColumnSpan="4"
                                  ItemsSource="{Binding DownloadOptions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RemoteGgufDownloadOptionRowViewModel">
                          <Border Background="White"
                                  BorderBrush="#F1D2A8"
                                  BorderThickness="1"
                                  CornerRadius="8"
                                  Padding="8,5"
                                  Margin="0,0,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Quant}" Foreground="#C15F00" FontWeight="Bold"/>
                              <TextBlock Text="{Binding Label}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding FileCountText}" Foreground="#7B6C5B"/>
                              <TextBlock Text="{Binding SizeText}" Foreground="#7B6C5B"/>
                              <TextBlock Text="{Binding ModeText}" Foreground="#247187"/>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding RemoteDownloadOptions}"
                     SelectedItem="{Binding SelectedRemoteDownloadOption}"
                     MaxHeight="120">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RemoteGgufDownloadOptionRowViewModel">
                  <Grid ColumnDefinitions="90,*,85,80,70" ColumnSpacing="8" Margin="0,4">
                    <TextBlock Grid.Column="0" Text="{Binding Quant}" Foreground="#C15F00" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding FileCountText}" Foreground="#7B6C5B" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="#7B6C5B" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="{Binding ModeText}" Foreground="#247187" HorizontalAlignment="Right"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="1"
                    Content="Скачать выбранный GGUF"
                    Command="{Binding DownloadSelectedRemoteModelCommand}"
                    VerticalAlignment="Top"
                    Classes="primary"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <StackPanel Grid.Column="0" Spacing="4">
              <ProgressBar Minimum="0"
                           Maximum="100"
                           Value="{Binding DownloadProgressPercent}"
                           Height="8"/>
              <TextBlock Text="{Binding DownloadProgressText}"
                         Foreground="#765A36"
                         FontSize="12"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Отменить"
                    Command="{Binding CancelDownloadCommand}"
                    VerticalAlignment="Top"/>
          </Grid>
        </StackPanel>
      </Border>
      </StackPanel>
        </TabItem>
      </TabControl>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
