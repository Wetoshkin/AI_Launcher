<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels.Pages"
             xmlns:ctrl="using:Launcher.Desktop.Controls"
             xmlns:l="using:Launcher.Desktop.Localization"
             xmlns:conv="using:Launcher.Desktop.Converters"
             x:Class="Launcher.Desktop.Views.Pages.AgentsView"
             x:DataType="vm:AgentsViewModel">
  <Grid ColumnDefinitions="*,14,380" Margin="28,24" Background="{DynamicResource PaperBrush}">

    <ScrollViewer Grid.Column="0">
      <StackPanel Spacing="18" VerticalAlignment="Top">
        <StackPanel Spacing="6">
          <TextBlock Text="{l:T agents.title}" FontSize="30" FontWeight="ExtraBold"/>
          <TextBlock Text="{Binding Description}" FontSize="13.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Шаг 1: модель и параметры запуска -->
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Text="Шаг 1. Модель и параметры запуска" FontSize="17" FontWeight="Bold"/>
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="9" ColumnSpacing="10">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T chat.engine}" VerticalAlignment="Center"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RuntimeExe}" PlaceholderText="llama-server.exe (ставится во вкладке «Среды»)"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T chat.model}" VerticalAlignment="Center"/>
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding LocalModelPath}" PlaceholderText="путь к .gguf (или выберите во вкладке «Модели»)"/>
                <Button Grid.Column="1" Content="{l:T common.browse}" Command="{Binding BrowseModelCommand}"/>
              </Grid>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{l:T chat.mode}" VerticalAlignment="Center"/>
                <ComboBox MinWidth="150" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/>
                <TextBlock Text="{l:T chat.port}" VerticalAlignment="Center"/>
                <TextBox Width="78" Text="{Binding ServerPort}"/>
                <Button Content="{l:T common.run}" Classes="primary" Command="{Binding StartServerCommand}"
                        IsEnabled="{Binding !IsServerStarting}" IsVisible="{Binding !IsServerRunning}"/>
                <Button Content="{l:T common.stop}" Classes="primary" Command="{Binding StopServerCommand}"
                        IsVisible="{Binding IsServerRunning}"/>
              </StackPanel>
            </Grid>

            <StackPanel Spacing="9">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Стиль ответов" VerticalAlignment="Center"/>
                <ComboBox MinWidth="170" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"/>
                <CheckBox Content="Экономить память" IsChecked="{Binding SaveMemory}" VerticalAlignment="Center"/>
                <ctrl:HelpHint Title="Экономия памяти"
                               Text="Квантование KV-кэша до q8_0 + Flash Attention режет память вдвое — больше контекст или модель. Если на вашем GPU не заработает (упадёт при старте), выключите."/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="MoE-эксперты на CPU" VerticalAlignment="Center"/>
                <CheckBox Content="Авто" IsChecked="{Binding MoeAuto}" VerticalAlignment="Center"/>
                <Slider Width="170" Minimum="0" Maximum="{Binding MoeMaxLayers}" Value="{Binding MoeCpuLayers}"
                        IsEnabled="{Binding !MoeAuto}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MoeCpuLayers}" VerticalAlignment="Center" MinWidth="26"/>
                <TextBlock Text="слоёв" VerticalAlignment="Center" Foreground="{DynamicResource InkSoftBrush}"/>
                <ctrl:HelpHint HelpId="ncmoe"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <CheckBox Content="Размышления (reasoning)" IsChecked="{Binding Reasoning}" VerticalAlignment="Center"/>
                <TextBlock Text="Глубина" VerticalAlignment="Center"/>
                <ComboBox MinWidth="150" SelectedIndex="{Binding ReasoningDepthIndex}" IsEnabled="{Binding Reasoning}">
                  <ComboBoxItem><TextBlock Text="Без лимита"/></ComboBoxItem>
                  <ComboBoxItem><TextBlock Text="Средне"/></ComboBoxItem>
                  <ComboBoxItem><TextBlock Text="Кратко"/></ComboBoxItem>
                </ComboBox>
                <ctrl:HelpHint HelpId="reasoning"/>
              </StackPanel>
            </StackPanel>

            <Expander Header="Эксперт: дополнительные аргументы">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Аргументы llama-server" VerticalAlignment="Center"/>
                  <ctrl:HelpHint Title="Дополнительные аргументы"
                                 Text="Полный контроль для профи. Примеры: --temp 0.6 --top-k 20 --top-p 0.95; --xtc-probability 0.5; --flash-attn on; --cache-type-k q8_0; --split-mode row. Анти-зацикливание (DRY) уже включено."/>
                </StackPanel>
                <TextBox Text="{Binding ExpertArgs}" PlaceholderText="--temp 0.6 --top-k 20 --xtc-probability 0.5" AcceptsReturn="False"/>
              </StackPanel>
            </Expander>

            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <CheckBox Content="Лог-стрим в браузере" IsChecked="{Binding LogStreamEnabled}" VerticalAlignment="Center"/>
                <TextBlock Text="Порт" VerticalAlignment="Center"/>
                <TextBox Width="78" Text="{Binding LogStreamPort}"/>
                <Button Content="Открыть в браузере" Command="{Binding OpenLogStreamCommand}" IsEnabled="{Binding LogStreamEnabled}"/>
              </StackPanel>
              <TextBlock Text="{Binding LogStreamStatus}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Шаг 2: агент и проект -->
        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Text="Шаг 2. Агент и проект" FontSize="17" FontWeight="Bold"/>

            <Border CornerRadius="9" Padding="12,10" Background="{DynamicResource AccentSoftBrush}">
              <Grid ColumnDefinitions="Auto,*">
                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,8,0"
                         Fill="{Binding IsModelRunning, Converter={x:Static conv:FitConverters.RunningToBrush}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ConnectionHint}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap"/>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="9" ColumnSpacing="10">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Проект" VerticalAlignment="Center"/>
              <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding ProjectFolder}" PlaceholderText="папка проекта"/>
                <Button Grid.Column="1" Content="{l:T common.browse}" Command="{Binding BrowseProjectCommand}"/>
              </Grid>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Агент" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="180" HorizontalAlignment="Left"
                        ItemsSource="{Binding AgentKinds}" SelectedItem="{Binding SelectedAgent}"/>
              <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Адрес" VerticalAlignment="Center"/>
                <ctrl:HelpHint Title="Источник модели"
                               Text="После запуска модели выше адрес подставляется сам. Для онлайн-провайдера впишите его адрес вручную."/>
              </StackPanel>
              <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,160" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding BaseUrl}"/>
                <TextBlock Grid.Column="1" Text="{l:T chat.model}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" Text="{Binding Model}"/>
              </Grid>
              <Button Grid.Row="3" Grid.Column="1" Content="Подготовить конфиг и запустить агента" Classes="primary"
                      HorizontalAlignment="Left" Command="{Binding PrepareAndLaunchCommand}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Установленные агенты -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{l:T agents.installed}" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Content="{l:T agents.check}" Command="{Binding CheckAgentsCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding Agents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AgentStatusRow">
                  <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,7">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Консоль сервера: видна всегда, чтобы сразу замечать ошибки запуска -->
    <Border Grid.Column="2" Classes="card" Padding="14">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="Консоль сервера" FontWeight="Bold" FontSize="15"/>
        <TextBlock Grid.Row="1" Text="{Binding ServerStatus}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource InkSoftBrush}"/>
        <Border Grid.Row="2" CornerRadius="8" Padding="10"
                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Grid>
            <TextBlock Text="Здесь появятся логи запуска модели. Нажмите «Запустить» — и сразу увидите, что стартовало и без ошибок ли."
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}"
                       IsVisible="{Binding ServerLog, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
            <ScrollViewer>
              <SelectableTextBlock Text="{Binding ServerLog}" FontFamily="Cascadia Code,Consolas,monospace"
                                   FontSize="11.5" Foreground="{DynamicResource InkBrush}"/>
            </ScrollViewer>
          </Grid>
        </Border>
        <Button Grid.Row="3" Content="{l:T common.clear}" HorizontalAlignment="Right"
                Command="{Binding ClearLogCommand}"
                IsVisible="{Binding ServerLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
