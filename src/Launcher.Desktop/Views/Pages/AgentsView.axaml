<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels.Pages"
             xmlns:ctrl="using:Launcher.Desktop.Controls"
             xmlns:l="using:Launcher.Desktop.Localization"
             xmlns:conv="using:Launcher.Desktop.Converters"
             x:Class="Launcher.Desktop.Views.Pages.AgentsView"
             x:DataType="vm:AgentsViewModel">
  <Grid RowDefinitions="*,Auto" Margin="28,24,28,16" Background="{DynamicResource PaperBrush}">

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16" VerticalAlignment="Top" Margin="0,0,16,0">
        <StackPanel Spacing="6">
          <TextBlock Text="{l:T agents.title}" FontSize="30" FontWeight="ExtraBold"/>
          <TextBlock Text="{Binding Description}" FontSize="13.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 1. Модель -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="1. Модель" FontSize="16" FontWeight="Bold"/>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding LocalModels}" SelectedItem="{Binding SelectedLocalModel}"
                        PlaceholderText="выберите локальную модель (частые — выше)"/>
              <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshLocalModelsCommand}"/>
              <Button Grid.Column="2" Content="Файл…" Command="{Binding BrowseModelCommand}"/>
            </Grid>
            <TextBox Text="{Binding LocalModelPath}" PlaceholderText="путь к .gguf"
                     Foreground="{DynamicResource InkSoftBrush}" FontSize="12"/>
            <TextBlock Text="Список берётся из папки, указанной во вкладке «Модели». Самые часто запускаемые — наверху."
                       FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- 2. Папка проекта -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="2. Папка проекта" FontSize="16" FontWeight="Bold"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Grid.Column="0" Text="{Binding ProjectFolder}" PlaceholderText="папка, в которой будет работать агент"/>
              <Button Grid.Column="1" Content="{l:T common.browse}" Command="{Binding BrowseProjectCommand}"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- 3. Агент -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="3. Агент" FontSize="16" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ComboBox MinWidth="180" ItemsSource="{Binding AgentKinds}" SelectedItem="{Binding SelectedAgent}"/>
              <Button Content="{l:T agents.check}" Command="{Binding CheckAgentsCommand}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Agents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AgentStatusRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12.5" FontWeight="SemiBold"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 4. Параметры запуска -->
        <Border Classes="card">
          <StackPanel Spacing="13">
            <TextBlock Text="4. Параметры запуска" FontSize="16" FontWeight="Bold"/>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="9" ColumnSpacing="12">
              <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Размер контекста" VerticalAlignment="Center"/>
                <ctrl:HelpHint Title="Контекст"
                               Text="Сколько токенов «помнит» модель. Кодинг-агенты шлют большой системный промпт и куски файлов — при маленьком контексте модель начинает «компактить» историю и не успевает ответить. Для агентов берите 32K и больше."/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                <ComboBox MinWidth="240" HorizontalAlignment="Left" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/>
                <TextBlock Text="{Binding SelectedPreset.Hint}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="KV-кэш (турбоквант)" VerticalAlignment="Center"/>
                <ctrl:HelpHint Title="Сжатие KV-кэша"
                               Text="Кэш контекста можно сжимать: q8_0 — вдвое меньше памяти почти без потери качества, q4_0 — вчетверо (максимум контекста в ту же видеопамять). Включает Flash Attention."/>
              </StackPanel>
              <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="280" HorizontalAlignment="Left"
                        ItemsSource="{Binding KvCacheModes}" SelectedItem="{Binding SelectedKvCache}"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Стиль ответов" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="2" Grid.Column="1" MinWidth="200" HorizontalAlignment="Left"
                        ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"/>
            </Grid>

            <!-- Прогноз памяти -->
            <Border CornerRadius="11" Padding="13" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Spacing="9">
                <TextBlock Text="Прогноз: как модель и контекст лягут в память" FontSize="13.5" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding GpuFillSummary}" FontSize="12.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding GpuFill}" IsVisible="{Binding HasGpuFill}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GpuFillRow">
                      <Grid ColumnDefinitions="160,*,Auto" Margin="0,0,0,7" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent}" Height="10"
                                     VerticalAlignment="Center"
                                     Foreground="{Binding Level, Converter={x:Static conv:FitConverters.LevelToBrush}}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Text}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource InkSoftBrush}"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <StackPanel Spacing="9">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="MoE-эксперты на CPU" VerticalAlignment="Center"/>
                <CheckBox Content="Авто" IsChecked="{Binding MoeAuto}" VerticalAlignment="Center"/>
                <Slider Width="170" Minimum="0" Maximum="{Binding MoeMaxLayers}" Value="{Binding MoeCpuLayers}"
                        IsEnabled="{Binding !MoeAuto}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding MoeCpuLayers}" VerticalAlignment="Center" MinWidth="26"/>
                <TextBlock Text="слоёв" VerticalAlignment="Center" Foreground="{DynamicResource InkSoftBrush}"/>
                <ctrl:HelpHint HelpId="ncmoe"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <CheckBox Content="Размышления (reasoning)" IsChecked="{Binding Reasoning}" VerticalAlignment="Center"/>
                <TextBlock Text="Глубина" VerticalAlignment="Center"/>
                <ComboBox MinWidth="150" SelectedIndex="{Binding ReasoningDepthIndex}" IsEnabled="{Binding Reasoning}">
                  <ComboBoxItem><TextBlock Text="Без лимита"/></ComboBoxItem>
                  <ComboBoxItem><TextBlock Text="Средне"/></ComboBoxItem>
                  <ComboBoxItem><TextBlock Text="Кратко"/></ComboBoxItem>
                </ComboBox>
                <ctrl:HelpHint HelpId="reasoning"/>
                <ctrl:HelpHint Title="MTP / спекулятивная генерация"
                               Text="Multi-Token Prediction (MTP) и спекулятивное декодирование ускоряют генерацию. Авто-определения для GGUF нет: если модель поддерживает draft-модель, задайте её в «своих аргументах» (--model-draft …). Для большинства моделей не требуется."/>
              </StackPanel>
            </StackPanel>

            <!-- Эксперт -->
            <StackPanel Spacing="10">
              <CheckBox Content="Экспертные параметры запуска" IsChecked="{Binding ShowExpert}" FontWeight="SemiBold"/>
              <StackPanel Spacing="10" IsVisible="{Binding ShowExpert}" Margin="2,0,0,0">
                <WrapPanel Orientation="Horizontal">
                  <CheckBox Content="Flash Attention" IsChecked="{Binding FlashAttention}" Margin="0,0,18,6"/>
                  <CheckBox Content="Держать в ОЗУ (mlock)" IsChecked="{Binding KeepInRam}" Margin="0,0,18,6"/>
                  <CheckBox Content="Без mmap" IsChecked="{Binding NoMmap}" Margin="0,0,18,6"/>
                  <CheckBox Content="Сплит по строкам (мульти-GPU)" IsChecked="{Binding SplitModeRow}" Margin="0,0,18,6"/>
                  <CheckBox Content="Подробный лог" IsChecked="{Binding VerboseLog}" Margin="0,0,18,6"/>
                </WrapPanel>
                <StackPanel Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Свои аргументы llama-server" VerticalAlignment="Center" FontSize="12.5"/>
                    <ctrl:HelpHint Title="Дополнительные аргументы"
                                   Text="Полный контроль для профи: --temp 0.6 --top-k 20; --xtc-probability 0.5; --model-draft путь (спекулятивная генерация). Анти-зацикливание (DRY) уже включено."/>
                  </StackPanel>
                  <TextBox Text="{Binding ExpertArgs}" PlaceholderText="--temp 0.6 --top-k 20 --xtc-probability 0.5" AcceptsReturn="False"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- Движок и порт + лог-стрим -->
            <Expander Header="Движок, порт, лог-стрим">
              <StackPanel Spacing="9" Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T chat.engine}" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RuntimeExe}" PlaceholderText="llama-server.exe (из вкладки «Среды»)"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T chat.port}" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding ServerPort}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox Content="Лог-стрим в браузере" IsChecked="{Binding LogStreamEnabled}" VerticalAlignment="Center"/>
                  <TextBox Width="78" Text="{Binding LogStreamPort}"/>
                  <Button Content="Открыть в браузере" Command="{Binding OpenLogStreamCommand}" IsEnabled="{Binding LogStreamEnabled}"/>
                </StackPanel>
                <TextBlock Text="{Binding LogStreamStatus}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <!-- Подключение + Старт -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Border CornerRadius="9" Padding="12,10" Background="{DynamicResource AccentSoftBrush}">
              <Grid ColumnDefinitions="Auto,*">
                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,8,0"
                         Fill="{Binding IsModelRunning, Converter={x:Static conv:FitConverters.RunningToBrush}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ConnectionHint}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap"/>
              </Grid>
            </Border>
            <Grid ColumnDefinitions="Auto,Auto,160" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="Адрес/модель" VerticalAlignment="Center" Foreground="{DynamicResource InkSoftBrush}" FontSize="12"/>
              <TextBox Grid.Column="1" Width="240" Text="{Binding BaseUrl}"/>
              <TextBox Grid.Column="2" Text="{Binding Model}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="🚀 Старт — запустить модель и агента" Classes="primary" FontSize="14"
                      Command="{Binding PrepareAndLaunchCommand}"/>
              <Button Content="Только сервер" Command="{Binding StartServerCommand}"
                      IsEnabled="{Binding !IsServerStarting}" IsVisible="{Binding !IsServerRunning}"/>
              <Button Content="■ Остановить сервер" Command="{Binding StopServerCommand}"
                      IsVisible="{Binding IsServerRunning}"/>
            </StackPanel>
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Консоль сервера: фиксирована снизу, всегда видна, со своим скроллом -->
    <Border Grid.Row="1" Classes="card" Padding="12" Margin="0,12,0,0" Height="200">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Консоль сервера" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ServerStatus}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="1" Content="{l:T common.clear}" Command="{Binding ClearLogCommand}"
                  IsVisible="{Binding ServerLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </Grid>
        <Border Grid.Row="1" CornerRadius="8" Padding="10"
                Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <Grid>
            <TextBlock Text="Здесь появятся логи запуска модели. Нажмите «Только сервер» или «Старт» — и сразу увидите, что стартовало и без ошибок ли."
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource InkSoftBrush}"
                       IsVisible="{Binding ServerLog, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <SelectableTextBlock Text="{Binding ServerLog}" FontFamily="Cascadia Code,Consolas,monospace"
                                   FontSize="11.5" Foreground="{DynamicResource InkBrush}"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
