<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels.Pages"
             xmlns:ctrl="using:Launcher.Desktop.Controls"
             xmlns:l="using:Launcher.Desktop.Localization"
             x:Class="Launcher.Desktop.Views.Pages.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <UserControl.Styles>
    <Style Selector="Button.action">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="20"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.action:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
    </Style>
    <Style Selector="Button.actionPrimary">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="40,32" Spacing="22" VerticalAlignment="Top">

      <!-- Hero -->
      <Border CornerRadius="20" ClipToBounds="True" Height="172" BoxShadow="0 10 30 0 #2A000000">
        <Panel>
          <Image Source="avares://Launcher.Desktop/Assets/hero.png" Stretch="UniformToFill"/>
          <StackPanel Margin="32,0" VerticalAlignment="Center" Spacing="8">
            <TextBlock Text="AI Launcher Studio" FontSize="30" FontWeight="ExtraBold" Foreground="White"/>
            <TextBlock Text="{l:T home.subtitle}" FontSize="14.5" Foreground="#FFFFFF" Opacity="0.92"
                       TextWrapping="Wrap" MaxWidth="560"/>
          </StackPanel>
        </Panel>
      </Border>

      <!-- Онбординг (первый запуск) -->
      <Border IsVisible="{Binding ShowOnboarding}" CornerRadius="16" Padding="20"
              Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <StackPanel Spacing="9">
          <TextBlock Text="{l:T onboard.title}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
          <TextBlock Text="{l:T onboard.step1}" FontSize="13.5"/>
          <TextBlock Text="{l:T onboard.step2}" FontSize="13.5"/>
          <TextBlock Text="{l:T onboard.step3}" FontSize="13.5"/>
          <Button Content="{l:T onboard.cta}" Classes="primary" HorizontalAlignment="Left"
                  Command="{Binding OpenRuntimesCommand}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <!-- Быстрый повтор последнего запуска -->
      <Border IsVisible="{Binding HasQuickLaunch}" Classes="card">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="⚡ Повторить последний запуск" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="{Binding QuickLaunchSummary}" FontSize="13" Foreground="{DynamicResource InkSoftBrush}"
                       TextWrapping="Wrap"/>
          </StackPanel>
          <Button Grid.Column="1" Content="Запустить" Classes="primary" VerticalAlignment="Center"
                  Command="{Binding QuickLaunchCommand}"/>
        </Grid>
      </Border>

      <!-- Основное действие -->
      <Button Classes="action actionPrimary" Command="{Binding OpenAgentsCommand}">
        <StackPanel Spacing="8">
          <TextBlock Text="🚀" FontSize="26"/>
          <TextBlock Text="Запустить модель и агента" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="Выберите модель, папку проекта и агента — и начните работу." FontSize="13"
                     Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Button>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
        <Button Grid.Column="0" Classes="action" Command="{Binding OpenModelsCommand}">
          <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock Text="📦" FontSize="15"/>
              <TextBlock Text="{l:T home.models.title}" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{l:T home.models.desc}" FontSize="12.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="action" Command="{Binding OpenRuntimesCommand}">
          <StackPanel Spacing="5">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock Text="⚙️" FontSize="15"/>
              <TextBlock Text="{l:T home.runtimes.title}" FontSize="15" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{l:T home.runtimes.desc}" FontSize="12.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Button>
      </Grid>

    </StackPanel>
  </ScrollViewer>
</UserControl>
