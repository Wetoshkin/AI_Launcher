<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels.Pages"
             xmlns:l="using:Launcher.Desktop.Localization"
             xmlns:conv="using:Launcher.Desktop.Converters"
             x:Class="Launcher.Desktop.Views.Pages.ModelsView"
             x:DataType="vm:ModelsViewModel">
  <ScrollViewer>
    <StackPanel Margin="40,32" Spacing="22" VerticalAlignment="Top" MaxWidth="1000" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Text="{l:T models.title}" FontSize="30" FontWeight="ExtraBold"/>
        <TextBlock Text="{Binding Description}" FontSize="13.5" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Text="{l:T models.local}" FontSize="17" FontWeight="Bold"/>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding ModelsFolder}" PlaceholderText="D:\AI\Models"/>
            <Button Grid.Column="1" Content="{l:T common.browse}" Command="{Binding BrowseFolderCommand}"/>
            <Button Grid.Column="2" Content="{l:T common.scan}" Classes="primary" Command="{Binding ScanCommand}"/>
          </Grid>
          <TextBlock Text="{Binding LocalStatus}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}"/>
          <ItemsControl ItemsSource="{Binding LocalModels}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LocalModelRow">
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource InkSoftBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7"
                            Padding="9,3" Margin="8,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Quant}" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Size}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <Button Grid.Row="0" Grid.Column="3" Content="Использовать" Classes="primary" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:ModelsViewModel)DataContext).UseLocalCommand}"
                            CommandParameter="{Binding}"/>
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="7" Margin="0,9,0,0">
                      <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                               Fill="{Binding FitLevel, Converter={x:Static conv:FitConverters.LevelToBrush}}"/>
                      <TextBlock Text="{Binding Fit}" FontSize="12.5" FontWeight="Medium"
                                 Foreground="{Binding FitLevel, Converter={x:Static conv:FitConverters.LevelToBrush}}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Text="{l:T models.hf}" FontSize="17" FontWeight="Bold"/>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding SearchQuery}" PlaceholderText="qwen2.5 coder"/>
            <Button Grid.Column="1" Content="{l:T common.search}" Classes="primary" Command="{Binding SearchHuggingFaceCommand}"/>
          </Grid>
          <TextBlock Text="{Binding SearchStatus}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}"/>
          <ItemsControl ItemsSource="{Binding SearchResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HfModelRow">
                <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                      <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock Text="{Binding Stats}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}"/>
                        <TextBlock Text="{Binding Quants}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,2,0,0">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding FitLevel, Converter={x:Static conv:FitConverters.LevelToBrush}}"/>
                        <TextBlock Text="{Binding Fit}" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{Binding FitLevel, Converter={x:Static conv:FitConverters.LevelToBrush}}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding DownloadStatus}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding DownloadStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="⬇ Скачать" Classes="primary" VerticalAlignment="Center" Margin="10,0,0,0"
                            IsEnabled="{Binding !IsBusy}"
                            IsVisible="{Binding HasGguf}"
                            Command="{Binding $parent[ItemsControl].((vm:ModelsViewModel)DataContext).DownloadHfCommand}"
                            CommandParameter="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
