<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels.Pages"
             xmlns:ctrl="using:Launcher.Desktop.Controls"
             x:Class="Launcher.Desktop.Views.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="32" Spacing="20" VerticalAlignment="Top" MaxWidth="900" HorizontalAlignment="Left">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="{Binding Description}" FontSize="14" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="14" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="Подсказки у параметров" FontSize="16" FontWeight="Bold"/>
          <TextBlock Text="У каждого параметра есть иконка «?» — наведите, чтобы понять, что это и зачем."
                     FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Контекст" VerticalAlignment="Center"/>
            <ctrl:HelpHint HelpId="context"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="MTP" VerticalAlignment="Center"/>
            <ctrl:HelpHint HelpId="mtp"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Тип KV-кэша (K)" VerticalAlignment="Center"/>
            <ctrl:HelpHint HelpId="kv-type-k"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Игнорировать конец ответа" VerticalAlignment="Center"/>
            <ctrl:HelpHint HelpId="ignore-eos"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="14" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="Проверка конфликтов настроек" FontSize="16" FontWeight="Bold"/>
          <TextBlock Text="Пример: включён MTP на модели без MTP-головы и контекст больше нативного."
                     FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
          <ctrl:ConflictPanel Findings="{Binding SampleFindings}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
