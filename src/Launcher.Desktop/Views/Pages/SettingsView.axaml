<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels.Pages"
             xmlns:ctrl="using:Launcher.Desktop.Controls"
             xmlns:l="using:Launcher.Desktop.Localization"
             x:Class="Launcher.Desktop.Views.Pages.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="40,36" Spacing="24" VerticalAlignment="Top">
      <StackPanel Spacing="6">
        <TextBlock Text="{l:T settings.title}" FontSize="30" FontWeight="ExtraBold"/>
        <TextBlock Text="{l:T settings.subtitle}" FontSize="14" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
      </StackPanel>

      <!-- Внешний вид -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Text="{l:T settings.appearance}" FontSize="17" FontWeight="Bold"/>
          <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="14">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T settings.theme}" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left"
                      SelectedIndex="{Binding ThemeIndex}">
              <ComboBoxItem><TextBlock Text="{l:T settings.theme.light}"/></ComboBoxItem>
              <ComboBoxItem><TextBlock Text="{l:T settings.theme.dark}"/></ComboBoxItem>
              <ComboBoxItem><TextBlock Text="{l:T settings.theme.system}"/></ComboBoxItem>
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T settings.language}" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left"
                      SelectedIndex="{Binding LanguageIndex}">
              <ComboBoxItem><TextBlock Text="Русский"/></ComboBoxItem>
              <ComboBoxItem><TextBlock Text="English"/></ComboBoxItem>
            </ComboBox>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Система -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="{l:T settings.system}" FontSize="17" FontWeight="Bold"/>
          <CheckBox Content="{l:T settings.autostart}" IsChecked="{Binding AutoStart}"/>
          <StackPanel Spacing="2">
            <CheckBox Content="Использовать встроенную видеокарту для LLM" IsChecked="{Binding UseIntegratedGpu}"/>
            <TextBlock Text="По умолчанию выключено: встройка слабее и нужна Windows для отрисовки. Включите, только если у вас нет дискретной видеокарты или хотите добавить её память в расчёт."
                       FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap" Margin="28,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Обновления -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="{l:T settings.updates.title}" FontSize="17" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" Spacing="14">
            <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" Foreground="{DynamicResource InkSoftBrush}"/>
            <Button Content="{l:T settings.updates.check}" Command="{Binding CheckUpdatesCommand}"
                    IsEnabled="{Binding !IsCheckingUpdate}"/>
            <Button Content="⬇ Обновить сейчас" Classes="primary" Command="{Binding InstallUpdateCommand}"
                    IsVisible="{Binding CanInstallUpdate}" IsEnabled="{Binding !IsInstallingUpdate}"/>
          </StackPanel>
          <TextBlock Text="{Binding UpdateStatus}" FontSize="12.5" Foreground="{DynamicResource InkSoftBrush}"
                     TextWrapping="Wrap" IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Исходный код:" VerticalAlignment="Center" Foreground="{DynamicResource InkSoftBrush}" FontSize="12.5"/>
            <Button Classes="link" Command="{Binding OpenRepoCommand}" Padding="0" Background="Transparent" BorderThickness="0">
              <TextBlock Text="{Binding RepoUrl}" Foreground="{DynamicResource AccentBrush}" FontSize="12.5"
                         TextDecorations="Underline"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
