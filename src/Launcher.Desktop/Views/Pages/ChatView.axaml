<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels.Pages"
             xmlns:ctrl="using:Launcher.Desktop.Controls"
             xmlns:conv="using:Launcher.Desktop.Converters"
             xmlns:online="using:Launcher.Online"
             xmlns:l="using:Launcher.Desktop.Localization"
             x:Class="Launcher.Desktop.Views.Pages.ChatView"
             x:DataType="vm:ChatViewModel">
  <UserControl.Styles>
    <Style Selector="Border.msg">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
    </Style>
    <Style Selector="Border.msg.user">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="28,24" Background="{DynamicResource PaperBrush}">

    <!-- Подключение / локальный сервер -->
    <Border Grid.Row="0" Classes="card" Padding="18" Margin="0,0,0,14">
      <StackPanel Spacing="10">
        <Expander Header="{l:T chat.localserver}">
          <StackPanel Spacing="10" Margin="0,10,0,0">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:T chat.engine}" VerticalAlignment="Center"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RuntimeExe}" PlaceholderText="llama-server.exe"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:T chat.model}" VerticalAlignment="Center"/>
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding LocalModelPath}" AutomationProperties.Name="LocalModelPath"
                         PlaceholderText=".gguf"/>
                <Button Grid.Column="1" Content="{l:T common.browse}" Command="{Binding BrowseModelCommand}"/>
              </Grid>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{l:T chat.mode}" VerticalAlignment="Center"/>
                <ComboBox MinWidth="150" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/>
                <TextBlock Text="{l:T chat.port}" VerticalAlignment="Center"/>
                <TextBox Width="78" Text="{Binding ServerPort}"/>
                <Button Content="{l:T common.run}" Classes="primary" Command="{Binding StartServerCommand}"
                        IsEnabled="{Binding !IsServerStarting}"/>
                <Button Content="{l:T common.stop}" Command="{Binding StopServerCommand}" IsEnabled="{Binding IsServerRunning}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding ServerStatus}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>

            <!-- Эксперт: произвольные аргументы -->
            <Expander Header="Эксперт: дополнительные аргументы">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Аргументы llama-server" VerticalAlignment="Center"/>
                  <ctrl:HelpHint Title="Дополнительные аргументы"
                                 Text="Полный контроль для профи. Примеры: --temp 0.6 --top-k 20 --top-p 0.95 (точный код); --xtc-probability 0.5 (разнообразие); --flash-attn on; --cache-type-k q8_0 (экономия памяти); --split-mode row. Анти-зацикливание (DRY) уже включено. У каждого параметра есть подсказка на вкладке Настройки."/>
                </StackPanel>
                <TextBox Text="{Binding ExpertArgs}" PlaceholderText="--temp 0.6 --top-k 20 --xtc-probability 0.5"
                         AcceptsReturn="False"/>
              </StackPanel>
            </Expander>

            <!-- Лог-консоль сервера -->
            <Expander Header="{l:T chat.log}" IsVisible="{Binding ServerLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                <Button Grid.Row="0" Content="{l:T common.clear}" HorizontalAlignment="Right"
                        Command="{Binding ClearLogCommand}" Margin="0,0,0,6"/>
                <Border Grid.Row="1" Height="200" CornerRadius="8" Padding="10"
                        Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                  <ScrollViewer>
                    <SelectableTextBlock Text="{Binding ServerLog}" FontFamily="Cascadia Code,Consolas,monospace"
                                         FontSize="11.5" Foreground="{DynamicResource InkSoftBrush}"/>
                  </ScrollViewer>
                </Border>
              </Grid>
            </Expander>
          </StackPanel>
        </Expander>

        <Expander Header="{l:T chat.connection}" IsExpanded="True">
          <StackPanel Spacing="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{l:T chat.provider}" VerticalAlignment="Center"/>
              <ComboBox MinWidth="190" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="online:ProviderPreset">
                    <TextBlock Text="{Binding DisplayName}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <CheckBox Content="{l:T chat.proxy}" IsChecked="{Binding UseProxy}" VerticalAlignment="Center"/>
              <ctrl:HelpHint Title="Proxy"
                             Text="Если онлайн-провайдер заблокирован, включите прокси Hiddify (127.0.0.1:12334). Локальные адреса всегда идут в обход."/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto,160,Auto,180" RowSpacing="8" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{l:T chat.address}" VerticalAlignment="Center"/>
              <TextBox Grid.Column="1" Text="{Binding BaseUrl}" PlaceholderText="http://127.0.0.1:8080/v1"/>
              <TextBlock Grid.Column="2" Text="{l:T chat.model}" VerticalAlignment="Center"/>
              <TextBox Grid.Column="3" Text="{Binding Model}"/>
              <TextBlock Grid.Column="4" Text="{l:T chat.apikey}" VerticalAlignment="Center"/>
              <TextBox Grid.Column="5" Text="{Binding ApiKey}" PasswordChar="•"/>
            </Grid>
          </StackPanel>
        </Expander>
        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}"/>
      </StackPanel>
    </Border>

    <!-- Сообщения -->
    <Border Grid.Row="1" Classes="card" Padding="8">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Messages}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageViewModel">
              <Border Classes="msg" Classes.user="{Binding IsUser}"
                      Margin="0,0,0,10" Padding="14,11" CornerRadius="14" MaxWidth="660"
                      HorizontalAlignment="{Binding IsUser, Converter={x:Static conv:ChatConverters.Alignment}}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Ввод -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,14,0,0">
      <TextBox Grid.Column="0" Text="{Binding Input}" PlaceholderText="{l:T chat.placeholder}"
               AutomationProperties.Name="ChatInput" AcceptsReturn="True" MaxHeight="120" TextWrapping="Wrap"/>
      <Button Grid.Column="1" Content="{l:T common.send}" Classes="primary"
              Command="{Binding SendCommand}" VerticalAlignment="Bottom"/>
      <Button Grid.Column="2" Content="{l:T common.stop}" Command="{Binding StopCommand}"
              IsEnabled="{Binding IsBusy}" VerticalAlignment="Bottom"/>
      <Button Grid.Column="3" Content="{l:T common.clear}" Command="{Binding ClearCommand}" VerticalAlignment="Bottom"/>
    </Grid>
  </Grid>
</UserControl>
