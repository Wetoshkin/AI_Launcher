<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.Desktop.ViewModels.Pages"
             xmlns:ctrl="using:Launcher.Desktop.Controls"
             xmlns:conv="using:Launcher.Desktop.Converters"
             xmlns:online="using:Launcher.Online"
             x:Class="Launcher.Desktop.Views.Pages.ChatView"
             x:DataType="vm:ChatViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" Background="{DynamicResource PaperBrush}">

    <!-- Подключение -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
      <StackPanel Spacing="8">
        <Expander Header="Локальный сервер — запустить модель на этом ПК">
          <StackPanel Spacing="8" Margin="0,10,0,0">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Движок" VerticalAlignment="Center"/>
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RuntimeExe}" PlaceholderText="путь к llama-server.exe (установите на вкладке Среды)"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Модель" VerticalAlignment="Center"/>
              <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding LocalModelPath}" AutomationProperties.Name="LocalModelPath"
                         PlaceholderText="путь к .gguf (выберите или скачайте на вкладке Модели)"/>
                <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseModelCommand}"/>
              </Grid>
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Порт" VerticalAlignment="Center"/>
                <TextBox Width="90" Text="{Binding ServerPort}"/>
                <Button Content="Запустить" Classes="primary" Command="{Binding StartServerCommand}"
                        IsEnabled="{Binding !IsServerStarting}"/>
                <Button Content="Остановить" Command="{Binding StopServerCommand}" IsEnabled="{Binding IsServerRunning}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding ServerStatus}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextWrapping="Wrap"/>
          </StackPanel>
        </Expander>
        <Expander Header="Подключение к модели" IsExpanded="True">
          <StackPanel Spacing="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Провайдер" VerticalAlignment="Center"/>
              <ComboBox MinWidth="200" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="online:ProviderPreset">
                    <TextBlock Text="{Binding DisplayName}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <CheckBox Content="Через прокси (Hiddify)" IsChecked="{Binding UseProxy}" VerticalAlignment="Center"/>
              <ctrl:HelpHint Title="Прокси"
                             Text="Если онлайн-провайдер заблокирован, включите прокси Hiddify (127.0.0.1:12334). Локальные адреса всегда идут в обход прокси."/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto,160,Auto,180" RowSpacing="8" ColumnSpacing="8">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="Адрес" VerticalAlignment="Center"/>
                <ctrl:HelpHint Title="Адрес сервера"
                               Text="Базовый URL OpenAI-совместимого API. Для локального llama-server обычно http://127.0.0.1:8080/v1."/>
              </StackPanel>
              <TextBox Grid.Column="1" Text="{Binding BaseUrl}" PlaceholderText="http://127.0.0.1:8080/v1"/>
              <TextBlock Grid.Column="2" Text="Модель" VerticalAlignment="Center"/>
              <TextBox Grid.Column="3" Text="{Binding Model}" PlaceholderText="local-model"/>
              <TextBlock Grid.Column="4" Text="API-ключ" VerticalAlignment="Center"/>
              <TextBox Grid.Column="5" Text="{Binding ApiKey}" PlaceholderText="не нужен локально" PasswordChar="•"/>
            </Grid>
          </StackPanel>
        </Expander>
        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource InkSoftBrush}"/>
      </StackPanel>
    </Border>

    <!-- Сообщения -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="12" Padding="6">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Messages}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChatMessageViewModel">
              <Border Margin="0,0,0,10" Padding="14,10" CornerRadius="12" MaxWidth="640"
                      HorizontalAlignment="{Binding IsUser, Converter={x:Static conv:ChatConverters.Alignment}}"
                      Background="{Binding IsUser, Converter={x:Static conv:ChatConverters.Bubble}}"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Ввод -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0">
      <TextBox Grid.Column="0" Text="{Binding Input}" PlaceholderText="Напишите сообщение…"
               AutomationProperties.Name="ChatInput"
               AcceptsReturn="True" MaxHeight="120" TextWrapping="Wrap"/>
      <Button Grid.Column="1" Content="Отправить" Classes="primary"
              Command="{Binding SendCommand}" VerticalAlignment="Bottom"/>
      <Button Grid.Column="2" Content="Стоп" Command="{Binding StopCommand}"
              IsEnabled="{Binding IsBusy}" VerticalAlignment="Bottom"/>
      <Button Grid.Column="3" Content="Очистить" Command="{Binding ClearCommand}" VerticalAlignment="Bottom"/>
    </Grid>
  </Grid>
</UserControl>
